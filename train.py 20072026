def _load_clip_tensor_single_frame(frame_path: str):
    img = Image.open(frame_path).convert("RGB")
    rgb_float = np.asarray(img).astype(np.float32) / 255.0
    tensor = inference_transform(np.asarray(img)).unsqueeze(0).unsqueeze(0)
    return tensor, rgb_float


def generate_gradcam_figures(model, test_entries, y_true, y_pred, output_dir, device, n_examples: int = 3):
    buckets = {"correct_fake": [], "correct_real": [], "misclassified": []}
    for entry, yt, yp in zip(test_entries, y_true, y_pred):
        if yt == yp:
            buckets["correct_fake" if yt == 1 else "correct_real"].append(entry)
        else:
            buckets["misclassified"].append(entry)

    picks = []
    for key in ("correct_fake", "correct_real", "misclassified"):
        if buckets[key]:
            picks.append((key, buckets[key][0]))
    
    # Add more examples if available
    for key in ("correct_fake", "correct_real"):
        if len(picks) < n_examples and buckets[key]:
            picks.extend([(key, e) for e in buckets[key][1:]])
    
    picks = picks[:n_examples]

    if not picks:
        print("Grad-CAM: no test examples available")
        return []

    try:
        cam = build_gradcam(model)
    except Exception as exc:
        print(f"Grad-CAM: could not build: {exc}")
        return []

    results = []
    for i, (kind, entry) in enumerate(picks):
        try:
            frame_path = entry.frame_paths[len(entry.frame_paths) // 2]
            tensor, rgb_float = _load_clip_tensor_single_frame(frame_path)
            tensor = tensor.to(device)
            tensor.requires_grad_(True)
            overlay = explain_prediction(cam, tensor, rgb_float)
            out_path = os.path.join(output_dir, f"gradcam_{i+1}_{kind}.png")
            Image.fromarray((overlay * 255).astype(np.uint8)).save(out_path)
            caption = f"{kind.replace('_', ' ')} ({entry.sample.label})"
            results.append((out_path, caption, entry))
        except Exception as exc:
            print(f"Grad-CAM: skipped example {i+1}: {exc}")
    return results


# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------

def main():
    args = parse_args()
    if args.smoke_test:
        args.max_videos = min(args.max_videos, 20)
        args.epochs = min(args.epochs, 3)
        args.frames_per_clip = min(args.frames_per_clip, 4)
        args.max_frames_per_video = min(args.max_frames_per_video, 6)
        args.patience = max(args.patience, 1)

    os.makedirs(args.output_dir, exist_ok=True)
    set_seed(args.seed)

    if not os.path.isdir(args.root_dir):
        print(f"ERROR: root_dir does not exist: {args.root_dir!r}", file=sys.stderr)
        sys.exit(1)

    # Load samples
    collections = tuple(c.strip() for c in args.collections.split(",") if c.strip())
    print(f"Loading samples from {args.root_dir!r}, collections={collections} ...")
    samples = datasets.load_faceforensics(root_dir=args.root_dir, collections=collections)
    
    if not samples:
        print(f"No videos found. Check directory structure.", file=sys.stderr)
        sys.exit(1)
    
    print(f"Found {len(samples)} videos total:")
    for collection, counts in datasets.collection_summary(samples).items():
        print(f"  {collection}: {counts}")

    # Sample down if needed
    if args.max_videos and args.max_videos > 0 and len(samples) > args.max_videos:
        samples = datasets.sample_for_quick_run(samples, max_total=args.max_videos, seed=args.seed)
        print(f"Sampled down to {len(samples)} videos:")
        for collection, counts in datasets.collection_summary(samples).items():
            print(f"  {collection}: {counts}")

    # Build cache
    print(f"Building face cache in {args.cache_dir!r} ...")
    entries = build_cache_for_samples(
        samples, cache_root=args.cache_dir,
        max_frames_per_video=args.max_frames_per_video
    )
    entries_by_path = {e.sample.path: e for e in entries}
    samples_cached = [e.sample for e in entries]
    print(f"Face cache ready for {len(samples_cached)}/{len(samples)} videos.")

    # Split using robust method
    train_s, val_s, test_s = balanced_video_split(samples_cached, seed=args.seed)
    
    for name, bucket in (("train", train_s), ("val", val_s), ("test", test_s)):
        counts = datasets.class_balance(bucket)
        print(f"  {name}: {len(bucket)} clips ({counts})")
        if not bucket or counts.get("real", 0) == 0 or counts.get("fake", 0) == 0:
            print(f"WARNING: Split '{name}' missing a class. This may affect results.")
    
    # Map to entries
    train_entries = [entries_by_path[s.path] for s in train_s if s.path in entries_by_path]
    val_entries = [entries_by_path[s.path] for s in val_s if s.path in entries_by_path]
    test_entries = [entries_by_path[s.path] for s in test_s if s.path in entries_by_path]

    if not train_entries or not val_entries or not test_entries:
        print("ERROR: Not enough data for all splits. Try increasing --max-videos.", file=sys.stderr)
        sys.exit(1)

    # Training
    device = get_device()
    print(f"Training on device: {device}")

    print("\n" + "="*60)
    print("Training the model...")
    print("="*60)
    
    model, best_epoch, history, hparams = train_with_early_stopping(
        train_entries, val_entries, args, device, label="main"
    )
    torch.save(model.state_dict(), os.path.join(args.output_dir, "best_model.pt"))

    # Evaluation
    print("\n" + "="*60)
    print("Evaluating on test set...")
    print("="*60)
    
    test_loader, _ = make_loader(
        test_entries, args.frames_per_clip, inference_transform,
        train=False, batch_size=args.batch_size,
        num_workers=args.num_workers, seed=args.seed
    )
    pos_weight = compute_pos_weight(train_s, device)
    _, y_true, y_pred, y_scores = evaluate_loader(model, test_loader, device, pos_weight)
    test_metrics = evaluation.evaluate(y_true, y_pred, y_scores)
    roc_points = evaluation.roc_curve_points(y_true, y_scores)
    
    print(f"\nTest Results:")
    print(f"  Accuracy:  {test_metrics['accuracy']:.3f}")
    print(f"  Precision: {test_metrics['precision']:.3f}")
    print(f"  Recall:    {test_metrics['recall']:.3f}")
    print(f"  F1-Score:  {test_metrics['f1']:.3f}")
    print(f"  AUC-ROC:   {test_metrics['auc_roc']:.3f}")

    # Generate visualizations
    print("\n" + "="*60)
    print("Generating visualizations...")
    print("="*60)
    
    try:
        plot_training_history(history, os.path.join(args.output_dir, "training_history.png"))
        print("  ✓ Training history plot saved")
    except Exception as exc:
        print(f"  ✗ Training history plot failed: {exc}")
    
    try:
        plot_confusion_matrix(test_metrics["confusion_matrix"],
                            os.path.join(args.output_dir, "confusion_matrix.png"))
        print("  ✓ Confusion matrix saved")
    except Exception as exc:
        print(f"  ✗ Confusion matrix failed: {exc}")

    try:
        plot_roc_curve(roc_points["fpr"], roc_points["tpr"], test_metrics["auc_roc"],
                       os.path.join(args.output_dir, "roc_curve.png"))
        print("  ✓ ROC curve saved")
    except Exception as exc:
        print(f"  ✗ ROC curve failed: {exc}")

    try:
        plot_sample_predictions(test_entries, y_true, y_pred, y_scores,
                                os.path.join(args.output_dir, "sample_predictions.png"))
        print("  ✓ Sample predictions saved")
    except Exception as exc:
        print(f"  ✗ Sample predictions failed: {exc}")

    # Grad-CAM
    try:
        gradcam_results = generate_gradcam_figures(
            model, test_entries, y_true, y_pred,
            args.output_dir, device, args.gradcam_examples
        )
        if gradcam_results:
            print(f"  ✓ {len(gradcam_results)} Grad-CAM visualizations saved")
        else:
            print("  ✗ No Grad-CAM visualizations generated")
    except Exception as exc:
        print(f"  ✗ Grad-CAM failed: {exc}")

    # Save results
    results = {
        "args": vars(args),
        "test_metrics": test_metrics,
        "best_epoch": best_epoch,
        "history": history,
        "dataset_counts": {
            "train": datasets.class_balance(train_s),
            "val": datasets.class_balance(val_s),
            "test": datasets.class_balance(test_s),
        },
        "num_samples": {
            "train": len(train_s),
            "val": len(val_s),
            "test": len(test_s),
        }
    }
    
    with open(os.path.join(args.output_dir, "metrics.json"), "w") as f:
        json.dump(results, f, indent=2)
    print("  ✓ Metrics saved to metrics.json")

    print("\n" + "="*60)
    print(f"Done! Results saved to {args.output_dir}/")
    print("="*60)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        print("train.py failed:", file=sys.stderr)
        traceback.print_exc()
        sys.exit(1)